NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Provided by you / the grader (passed through by setup if set in the shell)
OPENAI_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional, defaults to gpt-4.1-mini
OPENAI_MODEL=
